  cancelTime       DateTime?
  deliveryTime     DateTime?
  createdAt        DateTime          @default(now()) @db.Date
  updatedAt        DateTime?         @db.Date
  shop             TikTokShop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
   items            TikTokOrderItem[]
    financialQuality String            @default("legacy-unverified")
    financialRevision String           @default("legacy-v0")
   qualityMarkedAt  DateTime?
   sourceObservedAt DateTime?
   rawFinancialPayload Json?

  @@index([shopId])
  @@index([userId])
  @@index([orderStatus])
  @@index([tiktokCreatedAt])
  @@index([shopId, tiktokOrderId])
  @@index([createdAt])
}

model TikTokOrderItem {
  id                    String                @id @default(auto()) @map("_id") @db.ObjectId
  orderId               String                @db.ObjectId
  shopId                String                @db.ObjectId
  variantId             String?               @db.ObjectId // Optional FK to TikTokProductVariant
  tiktokOrderLineItemId String // TikTok order line item ID
  productId             String? // TikTok product ID (not our local ID)
  skuId                 String? // TikTok SKU ID
  productName           String
  skuName               String?
  sellerSku             String?
  productImageUrl       String?
   quantity              Int?
   originalPrice         Float? // Pre-discount unit price, only when supplied
   price                 Float? // Actual unit price, only when supplied
   discount              Float?
   subtotalAmount        Float?
   taxAmount             Float?
   refundAmount          Float?
   financialQuality     String                 @default("legacy-unverified")
   financialRevision    String                 @default("legacy-v0")
   qualityMarkedAt      DateTime?
   sourceObservedAt     DateTime?
   rawFinancialPayload  Json?
  currency              String? // Line-item currency supplied by TikTok
  isGift                Boolean?              @default(false)
  saleAttrs             Json? // Array of {attribute_id, attribute_name, attribute_value_name}
  createdAt             DateTime              @default(now()) @db.Date
  order                 TikTokOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant               TikTokProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([shopId])
  @@index([variantId])
  @@index([skuId])
}

// ─── Shopify Integration ───────────────────────────────────────────────────

model ShopifyShop {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  userId            String           @db.ObjectId
  shopDomain        String           @unique
  shopName          String
  accessToken       String
  scopes            String
  lastSyncedAt      DateTime?
  lowStockThreshold Int              @default(10)
  createdAt         DateTime         @default(now()) @db.Date
  updatedAt         DateTime?        @db.Date
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products          ShopifyProduct[]
  orders            ShopifyOrder[]

  @@index([userId])
}

model ShopifyProduct {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  shopId           String                  @db.ObjectId
  userId           String                  @db.ObjectId
  shopifyProductId String
  title            String
  handle           String
  description      String?
  vendor           String?
  productType      String?
  status           String
  tags             String[]                @default([])
  totalInventory   Int                     @default(0)
  tracksInventory  Boolean                 @default(true)
  featuredImageUrl String?
  lastSyncedAt     DateTime?
  createdAt        DateTime                @default(now()) @db.Date
  updatedAt        DateTime?               @db.Date
  shop             ShopifyShop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants         ShopifyProductVariant[]

  @@unique([shopId, shopifyProductId])
  @@index([shopId])
  @@index([userId])
  @@index([status])
}

model ShopifyProductVariant {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  productId         String         @db.ObjectId
  shopifyVariantId  String
  title             String
  displayName       String?
  sku               String?
  barcode           String?
  price             Float
  compareAtPrice    Float?
  currency          String? // Currency supplied by Shopify's MoneyV2 price fields
  inventoryQuantity Int            @default(0)
  inventoryPolicy   String?
  position          Int?
  availableForSale  Boolean        @default(false)
  createdAt         DateTime       @default(now()) @db.Date
  updatedAt         DateTime?      @db.Date
  product           ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, shopifyVariantId])
  @@index([productId])
  @@index([sku])
}

model ShopifyOrder {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  shopId            String             @db.ObjectId
  userId            String             @db.ObjectId
  shopifyOrderId    String             @unique
  orderName         String
  orderStatus       String
  financialStatus   String?
  fulfillmentStatus String
  totalAmount       Float
  subtotalAmount    Float
  shippingAmount    Float              @default(0)
  taxAmount         Float?
  currency          String
  test              Boolean            @default(false)
  confirmed         Boolean            @default(false)
  note              String?
  tags              String[]           @default([])
  customerEmail     String?
  customerFirstName String?
  customerLastName  String?
  shippingAddress   Json?
  cancelReason      String?
  shopifyCreatedAt  DateTime?
  shopifyUpdatedAt  DateTime?
  processedAt       DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now()) @db.Date
  updatedAt         DateTime?          @db.Date
  shop              ShopifyShop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
   items             ShopifyOrderItem[]
    financialQuality  String             @default("legacy-unverified")
   financialRevision String             @default("legacy-v0")
   qualityMarkedAt   DateTime?
   sourceObservedAt  DateTime?
   rawFinancialPayload Json?
    // Optional for MongoDB rollout. Missing legacy state is unsafe and excluded from attribution.
    isLineItemsComplete Boolean?

   @@index([shopId])
  @@index([userId])
  @@index([orderStatus])
  @@index([shopifyCreatedAt])
  @@index([shopId, shopifyOrderId])
}

model ShopifyOrderItem {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  orderId             String       @db.ObjectId
  shopId              String       @db.ObjectId
  variantId           String?      @db.ObjectId
   shopifyLineId       String
   // Immutable upstream identities retained even when the local catalog variant is absent or deleted.
   shopifyProductGid   String?
   shopifyVariantGid   String?
   name                String
   title               String
   quantity            Int
   // Optional source facts keep pre-rollout Mongo documents readable; absent is unsafe.
   orderedQuantity     Int?
   currentQuantity     Int
  unfulfilledQuantity Int
  sku                 String?
  price               Float
   discountedPrice     Float?
   currency            String? // Original unit-price currency supplied by Shopify
   originalUnitPriceAmount String?
   originalUnitPriceScale  Int?
   originalUnitPriceCurrency String?
   discountedUnitPriceAmount String?
   discountedUnitPriceScale  Int?
   discountedUnitPriceCurrency String?
   discountedLineAmount String?
   discountedLineScale  Int?
   discountedLineCurrency String?
  createdAt           DateTime     @default(now()) @db.Date
  order               ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shopId])
  @@index([variantId])
}

// Marketplace analytics state is deliberately channel-neutral: finance APIs and
// history permissions differ by seller, region, and OAuth grant.
// ─── Canonical Projection Foundation ──────────────────────────────────────

// Shop-scoped stable external offer identity. Display snapshots (sellerSku,
// names, image) are mutable and never used as identity.
model MarketplaceOffer {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  platform          String
  internalShopId    String    @db.ObjectId
  externalProductId String
  externalVariantId String?   // null with product sentinel for non-variants
  identityKey       String    @unique
  sellerSku         String?
  productName       String?
  variantName       String?
  imageUrl          String?
  firstSeenAt       DateTime  @default(now()) @db.Date
  lastSeenAt        DateTime  @default(now()) @db.Date
  createdAt         DateTime  @default(now()) @db.Date
  updatedAt         DateTime? @db.Date

  sourceLines  MarketplaceSourceSalesLine[]
  offerFacts   MarketplaceOfferPerformanceFact[]

  @@index([platform, internalShopId])
  @@index([platform, internalShopId, sellerSku])
}

// Platform-neutral canonical source line. Each upstream order line is projected
// once. Native money is stored in minor units with explicit scale and currency.
model MarketplaceSourceSalesLine {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  platform             String
  internalShopId       String    @db.ObjectId
  externalOrderId      String
  externalLineId       String
  offerId              String?   @db.ObjectId
  sellerSku            String?
  productName          String?
  orderDate            DateTime  @db.Date
  marketplaceQuantity  Int?      // null when source unknown
  grossItemSalesMinor  String?   // null when source unknown; BigInt as string
  amountScale          Int       @default(2)
  currency             String
  orderStatus          String?
  orderEligibility     String    @default("eligible") // eligible | ineligible | unknown
  quantityQuality      String    @default("observed") // verified | observed | unknown
  gmvQuality           String    @default("observed") // verified | observed | unknown
  sourceRevision       String?
  sourceObservedAt     DateTime  @default(now()) @db.Date
  createdAt            DateTime  @default(now()) @db.Date
  updatedAt            DateTime? @db.Date

  offer                MarketplaceOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerFacts           MarketplaceOfferPerformanceFact[]
  salesSkuFacts        SalesSkuPerformanceFact[]
  wmsFacts             WmsProductSalesFact[]

  @@unique([platform, internalShopId, externalOrderId, externalLineId])
  @@index([platform, internalShopId, orderDate])
  @@index([offerId])
}

// Offer-level projection keyed by source-line revision. Raw marketplace
// quantity and native GMV, independent of any Sales SKU or recipe.
model MarketplaceOfferPerformanceFact {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  sourceLineId        String    @db.ObjectId
  offerId             String    @db.ObjectId
  projectionKey       String    @unique
  quantity            Int?      // null when source unknown
  nativeGmvMinor      String?   // null when source unknown; BigInt as string
  amountScale         Int       @default(2)
  currency            String
  saleDate            DateTime  @db.Date
  calculationVersion  String    @default("v1")
  projectedAt         DateTime  @default(now()) @db.Date
  createdAt           DateTime  @default(now()) @db.Date
  updatedAt           DateTime? @updatedAt

  sourceLine          MarketplaceSourceSalesLine @relation(fields: [sourceLineId], references: [id], onDelete: Cascade)
  offer               MarketplaceOffer           @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, saleDate])
  @@index([sourceLineId])
}

// Confirmed-mapping projection keyed by source-line, mapping, calculation version.
// Records Sales SKU identity, native amount, and marketplace units.
model SalesSkuPerformanceFact {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  sourceLineId        String    @db.ObjectId
  mappingId           String    @db.ObjectId
  salesSkuId          String    @db.ObjectId
  projectionKey       String    @unique
  nativeAmountMinor   String    // BigInt as string
  amountScale         Int       @default(2)
  currency            String
  marketplaceUnits    Int?      // null when source quantity unknown
  saleDate            DateTime  @db.Date
  calculationVersion  String    @default("v1")
  projectedAt         DateTime  @default(now()) @db.Date
  createdAt           DateTime  @default(now()) @db.Date
  updatedAt           DateTime? @updatedAt

  sourceLine          MarketplaceSourceSalesLine @relation(fields: [sourceLineId], references: [id], onDelete: Cascade)

  @@index([salesSkuId, saleDate])
  @@index([sourceLineId])
  @@index([mappingId])
}

// Recipe-component projection keyed by source line, mapping, recipe version,
// component, calculation version. Normalized physical units and allocated GMV.
model WmsProductSalesFact {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  sourceLineId          String    @db.ObjectId
  mappingId             String    @db.ObjectId
  recipeId              String    @db.ObjectId
  wmsProductId          String    @db.ObjectId
  projectionKey         String    @unique
  normalizedUnits       Int       // marketplaceQuantity × unitsPerSalesSkuUnit
  allocatedGmvMinor     String    // BigInt as string
  allocationBasisPoints Int
  amountScale           Int       @default(2)
  currency              String
  saleDate              DateTime  @db.Date
  calculationVersion    String    @default("v1")
  projectedAt           DateTime  @default(now()) @db.Date
  createdAt             DateTime  @default(now()) @db.Date
  updatedAt             DateTime? @updatedAt

  sourceLine            MarketplaceSourceSalesLine @relation(fields: [sourceLineId], references: [id], onDelete: Cascade)

  @@index([wmsProductId, saleDate])
  @@index([sourceLineId])
  @@index([mappingId])
  @@index([recipeId])
}

// Admin-controlled backfill job with effective date, source bounds, checkpoints.
model MappingBackfillRun {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  initiatedById       String    @db.ObjectId
  platform            String
  internalShopId      String?   @db.ObjectId // null = all shops
  effectiveDate       DateTime  @db.Date
  dateFrom            DateTime  @db.Date
  dateTo              DateTime  @db.Date
  calculationVersion  String    @default("v1")
  idempotencyKey      String?
  status              String    @default("pending") // pending | running | completed | completed_with_errors | failed | cancelled
  checkpoint          Json?     // { lastSourceLineId, lastProcessedDate }
  processedCount      Int       @default(0)
  factCount           Int       @default(0)
  errorCount          Int       @default(0)
  errors              Json?     // Array of { sourceLineId, error }
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now()) @db.Date
  updatedAt           DateTime? @db.Date

  @@index([status])
  @@index([platform, internalShopId])
}

// ─── Marketplace Analytics State ──────────────────────────────────────────

model MarketplaceAnalyticsCapability {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  platform    String
  shopId      String   @db.ObjectId
  connectionId String? @db.ObjectId
  capability  String // orders, finance, refunds, settlements, buyer_identity
  state       String   @default("unknown") // unknown, pending, available, unavailable, unauthorized, failed
  detail      String?
  checkedAt   DateTime @default(now())
  observedAt  DateTime?
  endpointVersion String?
  grantFingerprint String?
  observedFields String[] @default([])
  errorCode   String?
  retryAt     DateTime?
  updatedAt   DateTime? @updatedAt
  connection  MarketplaceAnalyticsConnection? @relation(fields: [connectionId], references: [id])

  @@unique([platform, shopId, capability])
  @@index([userId, platform])
}

// Canonical analytics ownership is additive: legacy state continues to use
// platform/shopId until it is associated during a subsequent authorized write.
model MarketplaceAnalyticsConnection {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  platform       String
  shopId         String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  capabilities   MarketplaceAnalyticsCapability[]
  backfills      MarketplaceAnalyticsBackfill[]
  readiness      MarketplaceAnalyticsReadiness[]
  reconciliations MarketplaceAnalyticsReconciliation[]

  @@unique([platform, shopId])
  @@index([userId, platform])
}

// Finance is usable only after an explicit reconciliation, independently of
// endpoint capability and row-level provenance.
model MarketplaceAnalyticsReadiness {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  platform         String
  shopId           String   @db.ObjectId
  connectionId     String?  @db.ObjectId
  financeReady     Boolean  @default(false)
  reconciledAt     DateTime?
  reconciliationId String?
  detail           String?
  updatedAt        DateTime @updatedAt
  connection       MarketplaceAnalyticsConnection? @relation(fields: [connectionId], references: [id])

  @@unique([platform, shopId])
  @@index([userId, platform])
}

model MarketplaceAnalyticsBackfill {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  platform         String
  shopId           String   @db.ObjectId
  connectionId     String?  @db.ObjectId
  stream           String // orders, finance, refunds, settlements
  status           String   @default("pending") // pending, running, retrying, completed, failed, cancelled
  cursor           Json?
  windowStart      DateTime?
  windowEnd        DateTime?
  earliestReturned DateTime?
  error            String?
  retryCount       Int      @default(0)
  maxAttempts      Int      @default(5)
  nextAttemptAt    DateTime?
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  claimedAt        DateTime?
  lastAttemptAt    DateTime?
  completedAt      DateTime?
  checkpointAt     DateTime?
  pageCount        Int      @default(0)
  itemCount        Int      @default(0)
  idempotencyKey   String?
  terminalReason   String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  connection       MarketplaceAnalyticsConnection? @relation(fields: [connectionId], references: [id])

  @@unique([platform, shopId, stream])
  @@index([userId, platform, status])
}

// One immutable operator request may target a mutable backfill job. Keeping this
// separate makes retries safe without allowing a later request to overwrite its key.
model MarketplaceAnalyticsBackfillRequest {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  platform           String
  shopId             String   @db.ObjectId
  stream             String
  idempotencyKey     String
  action             String
  payloadFingerprint String
  outcome            String   @default("processing") // processing, accepted, cancelled, rejected
  statusCode         Int      @default(202)
  errorCode          String?
  errorMessage       String?
  cancelled          Boolean?
  jobId              String?  @db.ObjectId
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, platform, shopId, stream, idempotencyKey])
  @@index([platform, shopId, stream, createdAt])
}

// Metadata-only reconciliation evidence. Amounts are fixed-point strings and are
// never populated from marketplace payloads by this application.
model MarketplaceAnalyticsReconciliation {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  platform           String
  shopId             String   @db.ObjectId
  connectionId       String?  @db.ObjectId
  periodStart        DateTime
  periodEnd          DateTime
  calculationVersion String
  evidenceHash       String
  evidenceReference  String?
  currency           String?
  expectedMinor      String?
  actualMinor        String?
  deltaMinor         String?
  scale              Int      @default(2)
  reviewerId         String?  @db.ObjectId
  residualCategory   String?
  decision           String   @default("pending") // pending, approved, rejected
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  connection         MarketplaceAnalyticsConnection? @relation(fields: [connectionId], references: [id])

  @@index([platform, shopId, decision, expiresAt])
  @@index([connectionId])
}

// Raw signed finance rows are retained without forcing regional fee names into
// a lossy enum. Adapters can normalize them into the shared calculator later.
model MarketplaceFinancialRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  platform      String
  shopId        String   @db.ObjectId
  externalId    String
  // Lazada's documented finance `statement` / payout `statement_number` reference.
   statementExternalId String?
   orderExternalId String?
   orderInternalId String? @db.ObjectId
   orderLinkState String? // linked, unmatched, not_applicable
   itemExternalId String?
  transactionType String?
  feeType       String?
  feeName       String?
   // New finance writers use fixed-point minor units; amount remains only for legacy rows.
   amountMinor    String?
   amountScale    Int      @default(2)
   analyticsConnectionId String?
   amount        Float?
   financialQuality String @default("unknown")
   unknownReason String?
   sourceObservedAt DateTime?
  currency      String?
  occurredAt    DateTime?
  rawPayload    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([platform, shopId, externalId])
  @@index([analyticsConnectionId])
   @@index([platform, shopId, orderExternalId])
   @@index([platform, shopId, orderLinkState])
   @@index([platform, shopId, statementExternalId])
  @@index([occurredAt])
}
